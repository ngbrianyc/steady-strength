{
  "expo": {
    "name": "Steady Strength",
    "slug": "steady-strength",
    "owner": "ngbrianyc",
    "scheme": "steadystrength",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7F5F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.steadystrength.app"
    },
    "android": {
      "package": "com.steadystrength.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a0a9523e-d8ce-4201-975a-0e9628035048"
      }
    }
  }
}
